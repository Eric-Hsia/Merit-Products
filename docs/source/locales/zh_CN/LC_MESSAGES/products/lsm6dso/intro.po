#: ../en/products/lsm6dso/intro.md:1 15233fbb89874a878b9191b05744afb8
msgid "Introduction"
msgstr "产品介绍"

#: ../en/products/lsm6dso/intro.md:3 3b58b4767ccd491f90a3b45458dc5c7c
msgid "Overview"
msgstr "概述"

#: ../en/products/lsm6dso/intro.md:5 8b8fd3e200324c7e893629fab47913b3
msgid ""
"The **LSM6DSO-6DoF** is a high-performance 6-axis inertial measurement "
"unit (IMU) module, combining a 3-axis accelerometer and a 3-axis "
"gyroscope in a compact package."
msgstr "**LSM6DSO-6DoF** 是一款高性能六轴惯性测量单元（IMU）模块，在紧凑的封装中集成了三轴加速度计和三轴陀螺仪。"

#: ../en/products/lsm6dso/intro.md:7 d4e6643b30d7431c9f170a251839b622
msgid "Features"
msgstr "特性"

#: ../en/products/lsm6dso/intro.md:9 20483c216ead4cf48902f5d58c7700e9
msgid "**3-axis accelerometer**: ±2/±4/±8/±16 g full-scale range"
msgstr "**三轴加速度计**：±2/±4/±8/±16 g 满量程范围"

#: ../en/products/lsm6dso/intro.md:10 1a5520561c4d4528ad66b6b180f1bc60
msgid "**3-axis gyroscope**: ±125/±250/±500/±1000/±2000 dps full-scale range"
msgstr "**三轴陀螺仪**：±125/±250/±500/±1000/±2000 dps 满量程范围"

#: ../en/products/lsm6dso/intro.md:11 77c3dc7b3f62484f87e7fbe343d475d5
msgid "**Digital output**: I²C/SPI interface"
msgstr "**数字输出**：I²C/SPI 接口"

#: ../en/products/lsm6dso/intro.md:12 6f1bd5e3826a4ccea5ba406b33671386
msgid "**Low power consumption**: Ideal for battery-powered applications"
msgstr "**低功耗**：适用于电池供电应用"

#: ../en/products/lsm6dso/intro.md:13 8a231be5e2944aa599c6ce82bd96e49d
msgid "**Compact size**: 2.5mm × 3.0mm × 0.83mm"
msgstr "**紧凑尺寸**：2.5mm × 3.0mm × 0.83mm"

#: ../en/products/lsm6dso/intro.md:15 8251ad0de4084108960dc8f7bdfee343
msgid "Applications"
msgstr "应用场景"

#: ../en/products/lsm6dso/intro.md:17 1ef48a2ead4247f8aeb8a74a94ef69c2
msgid "Wearable devices"
msgstr "可穿戴设备"

#: ../en/products/lsm6dso/intro.md:18 64a859a898504b41bfe1332f26d9a45e
msgid "Motion tracking"
msgstr "运动追踪"

#: ../en/products/lsm6dso/intro.md:19 27379407f3bc469ebd5d0a655d24c1a6
msgid "Gesture recognition"
msgstr "手势识别"

#: ../en/products/lsm6dso/intro.md:20 00231a5be914483fa183de1e43d883f7
msgid "Gaming controllers"
msgstr "游戏手柄"

#: ../en/products/lsm6dso/intro.md:21 0c95062395724b52bb03bff2ae7b71e8
msgid "Robotics"
msgstr "机器人"

#: ../en/products/lsm6dso/intro.md:22 5e379de80e1a40ca8cede6228c1afa1b
msgid "IoT sensors"
msgstr "物联网传感器"

#: ../en/products/lsm6dso/intro.md:24 e54804eed3014109ad141b5cdfa0692f
msgid "Getting Started"
msgstr "快速入门"

#: ../en/products/lsm6dso/intro.md:26 00c484d017534ba3830ea282f721d94a
msgid "To get started with the LSM6DSO-6DoF module:"
msgstr "开始使用 LSM6DSO-6DoF 模块："

#: ../en/products/lsm6dso/intro.md:28 394c984919624e8794ae07d125871c58
msgid "Connect the module to your microcontroller via I²C or SPI"
msgstr "通过 I²C 或 SPI 将模块连接到您的微控制器"

#: ../en/products/lsm6dso/intro.md:29 1c70028f55ad48b3a08a74e0a65a7d72
msgid "Install the provided driver library"
msgstr "安装提供的驱动库"

#: ../en/products/lsm6dso/intro.md:30 38ee93bffb5e4d02a4c324210e006ba1
msgid "Initialize the sensor and start reading data"
msgstr "初始化传感器并开始读取数据"

#: ../en/products/lsm6dso/intro.md:31 7a4b4e26013a42b2acbb71707ed52385
