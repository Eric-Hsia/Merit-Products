# .gitignore for Merit-Products

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/
env/

# WorkBuddy
.workbuddy/

# Sphinx build output
docs/build/
docs/**/_build/
docs/**/sphinx-warning-log.txt

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# IDF build artifacts
examples/**/build/
examples/**/sdkconfig
examples/**/sdkconfig.old
examples/**/.cache/
examples/**/dependencies.lock
examples/**/managed_components/
